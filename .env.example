# ============================================================================
# Da Vinci — environment variables
#
# Copy this file to `.env` for local development (never commit `.env`), and
# set the same keys in your Netlify site's Environment variables for
# production. See DEPLOYMENT.md for where to get each value.
# ============================================================================

# ---- Supabase (database for reservations, contact messages, orders) -------
# Project Settings → API in your Supabase project.

# Used ONLY by the Netlify Functions (server-side). The browser never talks to
# the database directly, so there is no public key to set. NEVER prefix these
# with VITE_ — that would bundle them into the public site. Keep them secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (online ordering payments) -------------------------------------
# Dashboard → Developers → API keys. Use test keys until you've verified the
# full flow, then switch to live keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Resend (transactional email — order & reservation notifications) -----
# resend.com → API Keys. NOTIFICATIONS_FROM_EMAIL must be on a domain you've
# verified in Resend (e.g. orders@yourdomain.com).
RESEND_API_KEY=re_...
NOTIFICATIONS_FROM_EMAIL=orders@yourdomain.com

# ---- Site -------------------------------------------------------------------
# Your production URL, no trailing slash. Netlify sets `URL` automatically at
# build/runtime, so SITE_URL is only needed for local `netlify dev` testing.
SITE_URL=http://localhost:8888
